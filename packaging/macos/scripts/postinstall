# postinstall - runs after the Bursa.app payload is laid down.
#
# Bursa ships a single GUI binary, so (unlike adder) there is no CLI symlink to
# drop into /usr/local/bin. This script only refreshes Launch Services so the
# freshly installed bundle is picked up immediately.

# -u catches typos; no -e because the lsregister refresh below is best-effort
# and must never fail the install. We exit 0 regardless of its outcome.
set -u

APP_PATH="/Applications/Bursa.app"

# Refresh Launch Services so Finder/Spotlight immediately pick up the freshly
# installed bundle (icon, display name). Safe no-op if lsregister is
# unavailable. Failure here must not fail the install.
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
if [ -x "${LSREGISTER}" ] && [ -d "${APP_PATH}" ]; then
    "${LSREGISTER}" -f "${APP_PATH}" >/dev/null 2>&1 || true
fi

# Note: start-at-login is intentionally NOT handled here, keeping the installer
# generic. The app manages any such preference itself.

exit 0
