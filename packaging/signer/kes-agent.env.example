# EnvironmentFile for bursa-kes-agent.service. Install as
# /etc/bursa/kes-agent/kes-agent.env with mode 0600, owned by bursa-kes-agent.
# Overrides matching keys in kes-agent.yaml.

# BURSA_CONFIG=/etc/bursa/kes-agent/kes-agent.yaml

# --- Optional overrides (otherwise set in kes-agent.yaml) ---
# KESAGENT_MODE=serve-key
# KESAGENT_SERVICE_SOCKET=/run/bursa/kes-agent/service.sock
# KESAGENT_CONTROL_SOCKET=/run/bursa/kes-agent/control.sock
# KESAGENT_SERVICE_SOCKET_MODE=0600
# KESAGENT_CONTROL_SOCKET_MODE=0600
# KESAGENT_COLD_VKEY_FILE=/etc/bursa/kes-agent/cold.vkey
# KESAGENT_COLD_VKEY_HEX=
# KESAGENT_SYSTEM_START=2017-09-23T21:44:51Z
# KESAGENT_SLOT_LENGTH=1
# KESAGENT_SLOTS_PER_KES_PERIOD=129600
# KESAGENT_MAX_KES_EVOLUTIONS=62
# KESAGENT_EVOLVE_INTERVAL=1m
# KESAGENT_GUARD_FILE=/var/lib/bursa/kes-agent/guard.json
