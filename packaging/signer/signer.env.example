# EnvironmentFile for bursa-signer.service. Install as
# /etc/bursa/signer/signer.env with mode 0600, owned by bursa-signer.
# These override the matching keys in signer.yaml; keep SECRETS here, not in the
# YAML config.

# Path to the config file (redundant with --config in the unit; either works).
# BURSA_CONFIG=/etc/bursa/signer/signer.yaml

# --- Secrets ---
# HS256 shared secret (development). Minimum 32 bytes. Omit when using JWKS.
# SIGNER_JWT_SECRET=change-me-to-a-32-byte-minimum-random-secret

# Vault token for the `vault` backend (the token_env named in the backend).
# VAULT_TOKEN=s.xxxxxxxxxxxxxxxxxxxxxxxx

# Passphrase for passphrase-encrypted software-backend .skey files (dev only).
# BURSA_KEY_PASSPHRASE=...

# --- Optional overrides (otherwise set in signer.yaml) ---
# SIGNER_LISTEN_ADDRESS=0.0.0.0
# SIGNER_LISTEN_PORT=8090
# SIGNER_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# SIGNER_JWT_ISSUER=https://idp.example.com/
# SIGNER_JWT_AUDIENCE=bursa-signer
# SIGNER_TLS_CERT_FILE=/etc/bursa/signer/tls/server.crt
# SIGNER_TLS_KEY_FILE=/etc/bursa/signer/tls/server.key
# SIGNER_ALLOW_INSECURE_FILE_BACKEND=false
